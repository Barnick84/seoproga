# Copy this file to .env and fill in the real values.
# .env is git-ignored and must never be committed.

XMLRIVER_USER=
XMLRIVER_KEY=
XMLRIVER_REGION=213
XMLRIVER_ENGINE=yandex
XMLRIVER_REQUEST_DELAY=1.5
SIMILARITY_THRESHOLD=0.4
CACHE_TTL_DAYS=7
CONTENT_ANALYSIS_COMPETITORS=15

# Yandex Webmaster
YANDEX_OAUTH_TOKEN=
YANDEX_SITE_URL=

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=seo_auto
PG_USER=postgres
PG_PASSWORD=

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=seoapp
MYSQL_PASSWORD=
MYSQL_DBNAME=seo_auto

# Miratext
MIRATEXT_API_KEY=
MIRATEXT_REGION=213
MIRATEXT_MAX_WAIT=180
MIRATEXT_POLL_INTERVAL=3

# LLM
OPENAI_API_KEY=
BASE_URL=https://api.hydraai.ru/v1
LLM_MODEL=gemini-3-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# Cardlink payments
CARDLINK_SHOP_ID=
CARDLINK_TOKEN=

# Admin panel
ADMIN_PASSWORD=

# Security
JWT_SECRET=
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000