# Copy this file to .env and fill in the real values.
# .env is git-ignored and must never be committed.

# XMLRiver (SERP API)
XMLRIVER_USER=
XMLRIVER_KEY=
XMLRIVER_REGION=213
XMLRIVER_ENGINE=yandex
SIMILARITY_THRESHOLD=0.4

# Yandex Webmaster
YANDEX_OAUTH_TOKEN=
YANDEX_SITE_URL=

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=seo_auto
PG_USER=postgres
PG_PASSWORD=

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DBNAME=seo_auto

# Miratext
MIRATEXT_API_KEY=

# LLM (OpenAI-compatible endpoint)
OPENAI_API_KEY=
BASE_URL=https://api.hydraai.ru/v1
LLM_MODEL=gemini-3-flash

# Tegro Money API
TEGRO_SHOP_ID=
TEGRO_SECRET_KEY=
TEGRO_API_KEY=

# Admin panel
ADMIN_PASSWORD=

# Production server SSH (used by check_balance.py)
SSH_HOST=
SSH_USER=
SSH_PASSWORD=
